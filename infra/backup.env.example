# A dónde salen las copias de la base. En la VPS vive en /etc/devweb/backup.env
# con permisos 640 y dueño root:devweb. No se versiona con valores reales.
#
# Vacío significa que las copias se quedan en el mismo disco que la base, que es
# tanto como no tenerlas: un fallo del disco se lleva las dos.

# Remoto de rclone y carpeta, tal como lo llamaste en `rclone config`.
# Tiene que ser un remoto de tipo `crypt`: la base lleva correos y hashes de
# contraseñas, y eso no se sube en claro a casa de nadie. Ver infra/README.md.
DEVWEB_BACKUP_REMOTE=

# Dónde está la configuración de rclone. La lee el usuario del servicio, así que
# el fichero es root:devweb 640.
DEVWEB_RCLONE_CONF=/etc/devweb/rclone.conf

# Días que se guardan las copias. Fuera se guardan más tiempo porque es el sitio
# del que se tira cuando la máquina ya no está.
DEVWEB_BACKUP_RETENTION=7
DEVWEB_BACKUP_REMOTE_RETENTION=30
