[Unit]
Description=Copia de seguridad de la base de DevWeb

[Service]
Type=oneshot
User=devweb
Group=devweb
# El guión delante hace que el fichero sea opcional: sin él, la copia local
# sigue funcionando y solo se pierde la subida al destino remoto.
EnvironmentFile=-/etc/devweb/backup.env
ExecStart=/usr/local/bin/devweb-backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/devweb
