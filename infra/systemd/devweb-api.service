[Unit]
Description=DevWeb API
Documentation=https://github.com/OscarBlancoRosales/OscarBlancoDevWeb
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=devweb
Group=devweb
WorkingDirectory=/opt/devweb/current
ExecStart=/usr/bin/node /opt/devweb/current/server.mjs
EnvironmentFile=/etc/devweb/api.env

Restart=always
RestartSec=2
# Si se reinicia cinco veces en un minuto, algo no se arregla reiniciando.
StartLimitIntervalSec=60
StartLimitBurst=5

# El proceso solo necesita leer su código y escribir su base de datos. Todo lo
# demás que pueda tocar es superficie de ataque regalada.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RemoveIPC=true

# MemoryDenyWriteExecute NO se pone aquí, y no es un olvido.
#
# Prohíbe que un proceso tenga memoria escribible y ejecutable a la vez. Es una
# protección excelente contra la inyección de código... y es incompatible con
# cualquier runtime con JIT. V8 compila JavaScript a código máquina en memoria y
# lo ejecuta: es literalmente lo que esa opción impide. Con ella puesta, Node no
# arranca, aborta con V8_Fatal y deja un volcado de memoria.

ReadWritePaths=/var/lib/devweb

# AF_NETLINK hace falta para que la resolución de nombres funcione: libc lo usa
# para enumerar las interfaces de red antes de resolver. Sin él, el día que el
# servidor tenga que hablar con el relay de correo, fallaría con un error de DNS
# que no apunta a ninguna parte.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

MemoryMax=512M
TasksMax=256

StandardOutput=journal
StandardError=journal
SyslogIdentifier=devweb-api

[Install]
WantedBy=multi-user.target
