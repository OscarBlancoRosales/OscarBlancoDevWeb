# Configuración de la API. En la VPS vive en /etc/devweb/api.env con permisos
# 640 y dueño root:devweb. No se versiona con valores reales.

NODE_ENV=production
PORT=3000
HOST=127.0.0.1

DATABASE_PATH=/var/lib/devweb/devweb.db

# Lista blanca explícita, separada por comas. Sin comodines.
CORS_ORIGINS=https://oscarblancorosales.com

# Lo genera provision.sh con `openssl rand -hex 32`. Mínimo 32 caracteres.
JWT_SECRET=

ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30

# Punto para que la cookie valga en el dominio y en el subdominio de la API.
COOKIE_DOMAIN=.oscarblancorosales.com

PUBLIC_WEB_URL=https://oscarblancorosales.com

# Quién administra, separado por comas. El rol se aplica al arrancar el
# servicio: se le da a estas cuentas y se le quita a todas las demás.
#
# Se decide AQUÍ, en la máquina, y no desde ninguna ruta: así ni robando una
# sesión de administrador se puede fabricar otro administrador. Cambiarlo pide
# `systemctl restart devweb-api`.
#
# Vacío significa que nadie administra; y como el alta es solo por invitación y
# las invitaciones las reparte el panel, tampoco puede registrarse nadie.
ADMIN_EMAILS=oscar.blanco.r@gmail.com

# Relay externo. Correo propio desde una IP de VPS nueva acaba en spam.
SMTP_URL=
MAIL_FROM=OBRWeb <no-reply@oscarblancorosales.com>

# La clave de IA que consume la API: hoy la usa el presentador del Trivial.
#
# Va AQUÍ y no en la web. La web se publica en GitHub Pages, así que cualquier
# cosa que viaje con ella —incluido un fichero de configuración— la puede
# descargar cualquiera. Tampoco va como secreto de GitHub Actions: el workflow
# solo copia el paquete y lo despliega, no inyecta variables en la máquina.
#
# Vacía significa que el presentador del Trivial se calla y el juego sigue.
AI_KEY=
AI_PROVIDER=openrouter
AI_MODEL=
