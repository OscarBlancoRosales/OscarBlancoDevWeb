# Configuración de la API. En la VPS vive en /etc/devweb/api.env con permisos
# 640 y dueño root:devweb. No se versiona con valores reales.

NODE_ENV=production
PORT=3000
HOST=127.0.0.1

DATABASE_PATH=/var/lib/devweb/devweb.db

# Lista blanca explícita, separada por comas. Sin comodines.
CORS_ORIGINS=https://oscarblancorosales.com

# Lo genera provision.sh con `openssl rand -hex 32`. Mínimo 32 caracteres.
JWT_SECRET=

ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30

# Punto para que la cookie valga en el dominio y en el subdominio de la API.
COOKIE_DOMAIN=.oscarblancorosales.com

PUBLIC_WEB_URL=https://oscarblancorosales.com

# Relay externo. Correo propio desde una IP de VPS nueva acaba en spam.
SMTP_URL=
MAIL_FROM=DevWeb <no-reply@oscarblancorosales.com>
